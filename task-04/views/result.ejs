<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Result</title>
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">

  <style>
    body {
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #8f94fb, #4e54c8);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    header, footer {
      color: white;
      text-align: center;
      padding: 15px;
    }
    .result-box {
      background: #fff;
      padding: 25px;
      border-radius: 12px;
      box-shadow: 0px 4px 12px rgba(0,0,0,0.2);
      animation: fadeIn 0.8s ease-in-out;
    }
    .info-box {
      background: rgba(255, 255, 255, 0.15);
      color: white;
      padding: 25px;
      border-radius: 12px;
      animation: slideIn 1s ease-in-out;
    }
    h2 {
      text-align: center;
      color: #27ae60;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes slideIn {
      from { opacity: 0; transform: translateX(40px); }
      to { opacity: 1; transform: translateX(0); }
    }
  </style>
</head>
<body>
  
  <header class="bg-dark">
    <h2>Form-App Result</h2>
  </header>

  <main class="flex-grow-1 d-flex align-items-center p-3">
    <div class="container">
      <div class="row g-4">
        
        <!-- Latest submission -->
        <div class="col-lg-6">
          <div class="result-box">
            <h2>Form Submitted ✅</h2>
            <p><b>Name:</b> <%= name %></p>
            <p><b>Email:</b> <%= email %></p>
            <p><b>Phone:</b> <%= phone %></p>
            <p><b>Address:</b> <%= address %></p>
            <p><b>Gender:</b> <%= gender %></p>

            <div class="text-center mt-3">
              <a href="/" class="btn btn-primary">⬅ Back to Form</a>
            </div>
          </div>
        </div>

        <!-- All submissions -->
        <div class="col-lg-6 d-flex align-items-center">
          <div class="info-box w-100">
            <h3>All Submissions</h3>
            <ul>
              <% submissions.forEach((s, i) => { %>
                <li><b><%= i+1 %>.</b> <%= s.name %> | <%= s.email %> | <%= s.phone %> | <%= s.gender %></li>
              <% }) %>
            </ul>
            <p class="mt-2">Try submitting the form again with different values to test validation.</p>
          </div>
        </div>

      </div>
    </div>
  </main>

  <footer class="bg-dark">
    <p>© 2025 My Form-App | Responsive Design with Bootstrap</p>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

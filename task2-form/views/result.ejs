<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Result</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #8f94fb, #4e54c8);
      padding: 40px;
    }
    .result-box {
      background: #fff;
      padding: 25px;
      border-radius: 10px;
      box-shadow: 0px 4px 12px rgba(0,0,0,0.2);
      max-width: 500px;
      margin: auto;
    }
    h2 {
      text-align: center;
      color: #27ae60;
    }
    p {
      font-size: 15px;
      margin: 8px 0;
    }
    a {
      display: block;
      margin-top: 15px;
      text-align: center;
      color: #3498db;
      text-decoration: none;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <div class="result-box">
    <h2>Form Submitted ✅</h2>
    <p><b>Name:</b> <%= name %></p>
    <p><b>Email:</b> <%= email %></p>
    <p><b>Phone:</b> <%= phone %></p>
    <p><b>Address:</b> <%= address %></p>
    <p><b>Gender:</b> <%= gender %></p>

    <a href="/">⬅ Back to Form</a>
  </div>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Result</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<header>
  <h2>Form-App Result</h2>
</header>

<main class="flex-grow-1 d-flex align-items-center p-3">
  <div class="container">
    <div class="row g-4">
      <div class="col-lg-6">
        <div class="result-box">
          <h2>Form Submitted ✅</h2>
          <p><b>Name:</b> <%= name %></p>
          <p><b>Email:</b> <%= email %></p>
          <p><b>Phone:</b> <%= phone %></p>
          <p><b>Address:</b> <%= address %></p>
          <p><b>Gender:</b> <%= gender %></p>
          <div class="text-center mt-3">
            <a href="/" class="btn btn-primary">⬅ Back to Form</a>
          </div>
        </div>
      </div>

      <div class="col-lg-6 d-flex align-items-center">
        <div class="info-box w-100">
          <h3>All Submissions</h3>
          <ul>
            <% submissions.forEach((s, i) => { %>
              <li><b><%= i+1 %>.</b> <%= s.name %> | <%= s.email %> | <%= s.phone %> | <%= s.gender %></li>
            <% }) %>
          </ul>
          <p class="mt-2">Try submitting the form again with different values to test validation.</p>
        </div>
      </div>
    </div>
  </div>
</main>

<footer>
  <p>© 2025 My Form-App | Bootstrap & API</p>
</footer>
</body>
</html>
